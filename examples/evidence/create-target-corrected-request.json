{
  "gatewayIdentifier": "litellm-vpc-demo-demogateway",
  "name": "litellm-private",
  "clientToken": "dec4accf-9aae-4f59-b1b5-46d8cb4d490c",
  "description": "Private-only LiteLLM with API_KEY injection",
  "targetConfiguration": {
    "inference": {
      "provider": {
        "endpoint": "https://litellm-vpc-demo.example.com",
        "operations": [
          {
            "path": "/v1/chat/completions",
            "models": [
              {
                "model": "private-gpt-oss"
              },
              {
                "model": "private-network-check"
              }
            ]
          }
        ]
      }
    }
  },
  "credentialProviderConfigurations": [
    {
      "credentialProviderType": "API_KEY",
      "credentialProvider": {
        "apiKeyCredentialProvider": {
          "providerArn": "arn:aws:bedrock-agentcore:ap-northeast-1:123456789012:token-vault/default/apikeycredentialprovider/litellm-vpc-demo",
          "credentialLocation": "HEADER",
          "credentialParameterName": "Authorization",
          "credentialPrefix": "Bearer"
        }
      }
    }
  ],
  "metadataConfiguration": {
    "allowedRequestHeaders": [
      "x-probe-id"
    ]
  },
  "privateEndpoint": {
    "managedVpcResource": {
      "vpcIdentifier": "vpc-0000000000000000c",
      "subnetIds": [
        "subnet-0000000000000000a",
        "subnet-00000000000000009"
      ],
      "endpointIpAddressType": "IPV4",
      "securityGroupIds": [
        "sg-00000000000000008"
      ],
      "routingDomain": "internal-litellm-vpc-demo-1234567890.ap-northeast-1.elb.amazonaws.com"
    }
  }
}
